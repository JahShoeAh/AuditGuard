{
  "name": "auditguard-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run migrate && node src/index.js",
    "migrate": "node src/migrate.js",
    "migrate:make": "knex migrate:make --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "build": "vite build",
    "test": "npm run test:e2e",
    "test:e2e": "node test/e2e-simulation.test.js",
    "test:offline": "node test/offline-live-flow.test.js",
    "test:mocks": "node test/run-tests.js && node test/event-contract.test.js",
    "test:event-contract": "node test/event-contract.test.js",
    "test:persistence": "node test/state-persistence.test.js",
    "test:migrations": "node test/migration.test.js",
    "verify:persistence": "node scripts/verify-persistence.js",
    "verify:migrations": "node scripts/verify-migrations.js",
    "seed:live-agents": "node scripts/seed-live-agents.js",
    "test:live-smoke": "node scripts/live-smoke-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@hashgraph/sdk": "^2.24.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "hashconnect": "0.2.9",
    "knex": "^3.2.10",
    "pg": "^8.18.0",
    "prom-client": "^15.1.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "winston": "^3.12.0"
  }
}
